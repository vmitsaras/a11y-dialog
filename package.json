{
  "name": "@vmitsaras/a11y-dialog",
  "version": "1.0.0",
  "description": "A framework-agnostic native dialog helper with accessible focus, keyboard, lifecycle, and cleanup behavior.",
  "type": "module",
  "license": "MIT",
  "author": "Vasileios Mitsaras",
  "repository": {
    "type": "git",
    "url": "https://github.com/vmitsaras/a11y-dialog.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "dialog",
    "modal",
    "focus-management",
    "typescript"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./docs": {
      "types": "./dist/docs.d.ts",
      "import": "./dist/docs.js"
    },
    "./outcome": {
      "types": "./dist/outcome.d.ts",
      "import": "./dist/outcome.js"
    },
    "./async-action": {
      "types": "./dist/async-action.d.ts",
      "import": "./dist/async-action.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.js"
    },
    "./morph": {
      "types": "./dist/morph.d.ts",
      "import": "./dist/morph.js"
    },
    "./morph.css": "./dist/morph.css",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "copy:styles": "node scripts/copy-styles.mjs",
    "build": "npm run pages:build",
    "build:dist": "npm run clean && tsdown && npm run copy:styles",
    "build:pages": "npm run pages:build",
    "pages:build": "npm run build:dist && npm run pages:generate",
    "pages:generate": "node scripts/build-pages.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build:dist",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "happy-dom": "^20.10.6",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
